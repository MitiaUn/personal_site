---
import Layout from '../layouts/Layout.astro';
import ExternalLinkIcon from '../components/icons/ExternalLink.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : (rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase);

const results = [
  { year: "2026", sport: "Triathlon", event: "Challenge The Championship", location: "Slovakia", distance: "113km", time: "-", result: "Coming soon" },
  { year: "2026", sport: "Triathlon", event: "Triathlon Evian", location: "France", distance: "226km 4000m+", time: "-", result: "Coming soon" },
  { year: "2026", sport: "Run", event: "S25 Berlin", location: "Germany", distance: "25km", time: "1h30'", result: "1st M30\n4th Overall", link: "https://www.davengo.com/event/result/s-25-berlin-2026/detail/io-mFEvAyv7ycAk7LcqPSpdSxdzmIqRo0imxWxF1rs4", highlight: "gold" },
  { year: "2026", sport: "Trail Run", event: "UTMB Chianti 50K Trail", location: "Italy", distance: "46km 2000m+", time: "4h02", result: "My first ultra trail \n32nd man",link: "https://live.utmb.world/chianti/2026/runners/3100" },
  { year: "2026", sport: "XC Ski", event: "Engadin Marathon", location: "Switzerland", distance: "44km", time: "1h16'", result: "PB Marathon 1h13", link: "https://results.datasport.com/en/race/56-engadin-skimarathon-2026/participant/unuchek-dimitri", highlight: "pb" },
  { year: "2026", sport: "XC Ski", event: "La Transjurassienne", location: "France", distance: "50km 1000m+", time: "2h09'", result: "18th M18-34", link: "https://my.raceresult.com/380926/#1_888596" },
  { year: "2025", sport: "XC Ski", event: "Gommerlauf International", location: "Switzerland", distance: "42km", time: "1h45'", result: "13th M30", link: "https://www.datasport.com/live/ranking/?racenr=27704#4_4D907C" },
  { year: "2025", sport: "Triathlon", event: "Challenge San Remo", location: "Italy", distance: "113km 1500m+", time: "4h33'", result: "3rd M30-34", link: "https://my.raceresult.com/361042/", highlight: "bronze" },
  { year: "2025", sport: "Triathlon", event: "Triathlon de Lausanne", location: "Switzerland", distance: "51.5km 400m+", time: "2h17'", result: "PB Olympic", link: "https://www.datasport.com/live/ranking/?racenr=27506#1_6F4044", highlight: "pb" },
  { year: "2025", sport: "Skimo", event: "Patrouille des Aiguilles Rouges", location: "Switzerland", distance: "20km 2600m+", time: "5h03'", result: "My first patrouille", link: "https://sptiming.ch/par-25/" },
  { year: "2025", sport: "Skimo", event: "La Trace des Grands", location: "France", distance: "14km 2000m+", time: "3h36'", result: "My first SkiMo race", link: "https://my.raceresult.com/328968/#3_C380B5" },
  { year: "2025", sport: "Trail Run", event: "Défis des Chalets", location: "Switzerland", distance: "24km 1600m+", time: "2h22'", result: "5th Overall", link: "https://www.mso.swiss/events/2324-les-defis-des-chalets-trail-d'agaune/results" },
  { year: "2025", sport: "Trail Run", event: "XTERRA World Championship", location: "UK", distance: "21km 1200m+", time: "2h06'", result: "2nd M30-34\n4th Overall", link: "https://rankings.xterraplanet.com/results/d506fea2-b291-4b2f-8299-0c2acd8ed0c8?race=867efd97-4b7d-49e9-9daf-6f35466b0de7&gender=M", highlight: "silver" },

  { year: "2024", sport: "Trail Run", event: "XTERRA Vallée de Joux", location: "Switzerland", distance: "22km 800m+", time: "1h49'", result: "2nd M30-34\n10th Overall", link: "https://rankings.xterraplanet.com/results/6ec8079e-cc1e-42bb-abf2-56e2d5d7d9cc?race=0aed6635-bed6-46a3-9cf6-b32c0b018919", highlight: "silver" },
  { year: "2024", sport: "Triathlon", event: "Ironman 70.3 Emilia-Romagna", location: "Italy", distance: "113km", time: "4h18'", result: "PB 70.3 \n11th M30-34", link: "https://www.ironman.com/races/im703-emilia-romagna/results", highlight: "pb" },
  { year: "2024", sport: "Run", event: "Lausanne Half Marathon", location: "Switzerland", distance: "21.1km", time: "1h15'", result: "PB 21k \n32nd Overall", link: "https://www.datasport.com/live/ranking/?racenr=26110#2_66B6DA", highlight: "pb" },
  { year: "2021", sport: "Run", event: "Lausanne Marathon", location: "Switzerland", distance: "42.2km", time: "3h42'", result: "My first marathon" },
  { year: "-", sport: "Alpinism", event: "4000m Summits", location: "Alps & Andes", distance: "Various", time: "-", result: "10+ Summits" },
];

const highlights = [
  {
    title: "S25 Berlin 25km",
    year: "2026",
    summary: "Age group win and 4th overall.",
    description: "S25 Berlin 25km run, a huge event with thousands of participants. I secured 4th place overall and 1st in the M30 age group with a time of 01:30:10, missing the overall podium by just 1 minute and 1 place.",
    media: [
        { type: 'image', src: `${base}/pics_sport/2026%20Berlin%20S25/s-25-2026-1%20(1).jpg` },
        { type: 'image', src: `${base}/pics_sport/2026%20Berlin%20S25/136%20(1).jpg` },
        { type: 'image', src: `${base}/pics_sport/2026%20Berlin%20S25/137.jpg` },
        { type: 'image', src: `${base}/pics_sport/2026%20Berlin%20S25/025.jpg` }
    ],
    tags: ["Run", "Age Group Win"],
    links: [
        { label: "Results", url: "https://www.davengo.com/event/result/s-25-berlin-2026/detail/io-mFEvAyv7ycAk7LcqPSpdSxdzmIqRo0imxWxF1rs4" }
    ]
  },
  {
    title: "Challenge San Remo",
    year: "2025",
    summary: "Podium finish and Championship qualification.",
    description: "My most successful result to date on the middle distance triathlon race (1.9km swim, 80km 1500m+ bike, 21.1km run). Despite a car accident the day before preventing me from using my race bike, I pushed to the limit on the run course covering half marathon distance within 1h10', posting the fastest run split of the race. I finished in 4h33', crossing the line 8th overall and securing a podium spot as the 3rd fastest in the M30-34 age group, qualifying for the 2026 Challenge World Championship.",
    media: [
        { type: 'image', src: `${base}/pics_sport/SanRemo1.jpg` },
        { type: 'video', src: `${base}/pics_sport/SanRemo_video.MOV`, poster: `${base}/pics_sport/SanRemo1.jpg` }
    ],
    tags: ["Triathlon", "Qualification", "Challenge"],
    links: [
        { label: "Results", url: "https://my.raceresult.com/361042/" },
        { label: "Certificate", url: `${base}/pics_sport/Sanremo_certificate.pdf` }
    ]
  },
  {
    title: "XTERRA Trail Run World Championship",
    year: "2025",
    summary: "Silver medal at the World Cup in Wales.",
    description: "Trail running World Cup organized by XTERRA in Wales, UK, extending over 21km with 1200m elevation gain, passing by Snowdon, the highest summit in Wales. I finished 4th overall and 2nd in the M30-34 age group, earning a silver medal for the XTERRA World Cup 2025. The race was held under exceptional heatwave conditions, forcing organizers to eventually halt the event and launch rescue operation.",
    media: [
        { type: 'image', src: `${base}/pics_sport/Xterra1.JPG` },
        { type: 'image', src: `${base}/pics_sport/Xterra2.jpg` }, 
        { type: 'image', src: `${base}/pics_sport/Xterra3.jpg` },
        { type: 'image', src: `${base}/pics_sport/Xterra4.jpg` },
        { type: 'image', src: `${base}/pics_sport/Xterra5.jpg` }
    ],
    tags: ["Trail Run", "World Cup", "XTERRA"],
    links: [
        { label: "Results", url: "https://rankings.xterraplanet.com/results/d506fea2-b291-4b2f-8299-0c2acd8ed0c8?race=867efd97-4b7d-49e9-9daf-6f35466b0de7&gender=M" },
        { label: "Media Coverage", url: "https://xterraplanet.com/announcements/xterra-trail-run-world-championship-safety-first-community-always" }
    ]
  },
  {
    title: "Matterhorn Summit 4478m",
    year: "2024",
    summary: "Speed climbing under 2h30'.",
    description: "Speed ascent of the iconic Matterhorn via the Hörnli ridge (Swiss route, 1200m+, AD+ difficulty). While the average climbing time is 4-5 hours, I reached the summit in 2h26', marking the 3rd fastest time on this route according to Strava segment. This rapid ascent allowed me to enjoy a fantastic sunrise from the summit and avoid the crowds on the narrow passages, returning to Zermatt well before an approaching storm.",
    media: [
        { type: 'image', src: `${base}/pics_sport/Matterhorn0.png` },
        { type: 'image', src: `${base}/pics_sport/Matterhorn3.jpeg` },
        { type: 'image', src: `${base}/pics_sport/Matterhorn4.jpeg` },
        { type: 'image', src: `${base}/pics_sport/Matterhorn5.jpeg` },
    ],
    tags: ["Alpinism", "Leaderboard", "Strava"],
    links: [
        { label: "Strava Segment", url: "https://www.strava.com/segments/18516139" }
    ]
  },
  {
    title: "XTERRA Trail Vallée de Joux",
    year: "2024",
    summary: "Podium finish and World Cup qualification.",
    description: "XTERRA-branded trail running race in the French-speaking part of Switzerland, covering 22km and 800m of elevation gain, passing by Mont Tendre, the highest summit of the Swiss Jura mountains. I enjoyed every kilometer, finishing 10th overall and 2nd in my age group (M30-34), qualifying for the 2025 World Championship.",
    media: [
        { type: 'image', src: `${base}/pics_sport/Joux1.jpg` },
        { type: 'image', src: `${base}/pics_sport/Joux2.jpg` },
    ],
    tags: ["Trail Run", "Qualification", "XTERRA"],
    links: [
        { label: "Results", url: "https://rankings.xterraplanet.com/results/6ec8079e-cc1e-42bb-abf2-56e2d5d7d9cc?race=0aed6635-bed6-46a3-9cf6-b32c0b018919" }
    ]
  },
  {
    title: "Ironman 70.3 Emilia Romagna",
    year: "2024",
    summary: "Personal Record (4h18') for a half Ironman.",
    description: "My best performance on the half Ironman distance (1.9km swim, 90km bike, 21.1km run). With ideal race conditions, it was a lightning-fast course. I finished in 4h18', ranking 11th in my division and narrowly missing qualification for the Ironman World Championship.",
    media: [
        { type: 'image', src: `${base}/pics_sport/Emilia1.jpg` },
        { type: 'image', src: `${base}/pics_sport/Emilia2.jpg` },
    ],
    tags: ["Triathlon", "PB", "Ironman"],
    links: [
        { label: "Results", url: "https://www.ironman.com/races/im703-emilia-romagna/results" },
        { label: "Certificate", url: `${base}/pics_sport/EmiliaRomania_certificate.pdf` }
    ]
  },
];

const sportLinks = [
  { 
    name: 'Ironman', 
    url: 'https://www.coachcox.co.uk/imstats/athlete/1116394/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm-1 12H9v-4h2v4zm0-6H9V8h2v2z"/></svg>` 
  },
  { 
    name: 'ITRA', 
    url: 'https://itra.run/RunnerSpace/Unuchek-Dimitri/5948910',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 19l-2-6-2 4L6 14l-4 8h20L13.5 19zM19 6l-5 8h-3l2-6-3-4 6-2 3 4z"/></svg>`
  },
  { 
    name: 'UTMB', 
    url: 'https://utmb.world/runner/6642956.dimitri.unuchek',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4 18l8-14 8 14H4zm8-10l-4 7h8l-4-7z"/></svg>`
  },
  { 
    name: 'Strava', 
    url: 'https://www.strava.com/', 
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.387 17.944l-2.089-4.116h-3.065l5.154-8.128 5.154 8.128h-3.064l-2.09 4.116zm-5.154 5.356l-3.066-6.065h3.066l-1.93-3.032-5.93 10.932h3.93l1.93-1.835z"/></svg>`
  },
  {
    name: 'XTERRA',
    url: 'https://rankings.xterraplanet.com/athletes/60ad1c68-30d7-4d97-b0b3-5195e0385515',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>`
  },
  {
    name: 'Email',
    url: 'mailto:d.s.unuchek@gmail.com',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>`
  },
];
---

<Layout title="Sports Journey | Dimitri Unuchek" description="Dimitri Unuchek - Endurance Athlete" ogTitle="Dimitri Unuchek - Endurance Athlete" ogDescription="Triathlon, Trailrunning, Cross-Country Skiing" speedDialLinks={sportLinks} speedDialLabel="Follow Me">
  
  <!-- Mobile Profile Header (Visible only on phone) -->
  <div class="md:hidden flex flex-row items-center justify-center gap-6 pt-8 pb-8">
    <img 
      src={`${base}/pics_sport/main.jpg`} 
      alt="Dimitri Unuchek" 
      class="w-40 h-40 shrink-0 rounded-full border-[1.5px] border-white/20 object-cover shadow-2xl"
    />
    <div class="flex flex-col items-start gap-0.5">
      <h2 class="text-2xl font-bold tracking-tight text-slate-100">
        Dimitri Unuchek
      </h2>
      <p class="text-lg text-slate-400 font-light">
        Endurance Athlete
      </p>
      <p class="text-base text-slate-500 font-light">
        Lausanne, Switzerland
      </p>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="max-w-4xl mx-auto px-4 mb-16 pt-4 md:pt-16">
    <div class="flex flex-row items-stretch gap-6 md:gap-12">
      
      <!-- Rotated Title (Visible on both) -->
      <div class="flex flex-shrink-0 items-center justify-center border-r border-white/10 pr-6 md:pr-8">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-100 whitespace-nowrap" style="writing-mode: vertical-rl; transform: rotate(180deg);">
          Endurance<br class="hidden md:block"/><span class="md:hidden"> </span>& Alpinism
        </h1>
      </div>

      <!-- Bio Content -->
      <div class="text-justify flex-1 flex flex-col justify-center">
        <p class="text-lg text-slate-400 font-light leading-relaxed mb-6">
          I am an amateur athlete competing in triathlon, trail running, cross-country skiing, ski mountaineering, and alpinism, occasionally finding my way onto the <a href="#highlights" class="text-slate-300 hover:text-white underline decoration-slate-700 underline-offset-4 transition-colors">podium</a>. Currently, I am expanding my horizons by training for a paragliding license.
        </p>
        <p class="text-base text-slate-500 font-light leading-relaxed">
          Sport allows me to test my limits and push boundaries, while the grit and focus I’ve built through endurance sports are exactly what drive my <a href={`${base}/`} class="text-slate-300 hover:text-white underline decoration-slate-700 underline-offset-4 transition-colors">professional endeavors</a>. Meticulous planning, strict discipline and the stamina are what push complex project through to the finish line.
        </p>
      </div>
    </div>
  </section>

  <!-- Highlights Section -->
  <section id="highlights" class="max-w-4xl mx-auto px-4 mb-24">
    <div class="mb-10 border-b border-white/5 pb-4">
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400">
        Highlights
      </h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-12">
      {highlights.map(item => (
        <div class="group border border-white/5 rounded-2xl overflow-hidden bg-white/5 hover:bg-white/[0.07] transition-colors duration-300 highlight-card flex flex-col cursor-pointer" tabindex="0">
          <!-- Media Carousel -->
          <div class="aspect-video relative overflow-hidden group/media bg-black shrink-0">
             <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide h-full media-track pointer-events-none">
                {item.media.map((media, index) => (
                  <div class="min-w-full h-full snap-center relative">
                      {media.type === 'video' ? (
                          <video 
                            src={media.src} 
                            poster={media.poster}
                            controls 
                            muted
                            class="w-full h-full object-cover"
                            playsinline
                          />
                      ) : (
                           <img 
                              src={media.src} 
                              alt={`${item.title} - ${index + 1}`} 
                              class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                            />
                      )}
                  </div>
                ))}
             </div>
            
            {/* Gallery Navigation Buttons */}
            {item.media.length > 1 && (
              <>
                <button class="nav-btn prev absolute left-3 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full bg-black/40 text-white/70 hover:bg-black/70 hover:text-white backdrop-blur-sm transition-all opacity-0 pointer-events-none" aria-label="Previous photo">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                <button class="nav-btn next absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full bg-black/40 text-white/70 hover:bg-black/70 hover:text-white backdrop-blur-sm transition-all opacity-0 pointer-events-none" aria-label="Next photo">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </>
            )}
          </div>

          <div class="p-6 md:p-8 flex flex-col flex-1">
             <div class="flex justify-between items-start gap-4 mb-2">
                 <h3 class="text-xl font-semibold text-slate-100 tracking-tight">{item.title}</h3>
                 {/* Expand icon indicator */}
                 <div class="text-slate-500 transition-transform duration-300 group-data-[expanded=true]:rotate-180 flex-shrink-0">
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                     </svg>
                 </div>
             </div>
             
             {/* Tags & Year (Visible in both states) */}
             <div class="flex flex-wrap items-center gap-2 mb-4 text-[10px] uppercase tracking-wider text-slate-400 font-mono">
                 <span class="text-slate-300 font-medium">{item.year}</span>
                 {item.tags.map(tag => (
                     <>
                        <span class="opacity-50">•</span>
                        <span>{tag}</span>
                     </>
                 ))}
             </div>
             
             {/* Summary (Visible when folded, hidden when unfolded) */}
             <div class="summary-wrapper">
                 <div class="overflow-hidden">
                     <p class="text-slate-300 font-medium text-sm pb-1">{item.summary}</p>
                 </div>
             </div>

             {/* Details (Hidden when folded, visible when unfolded) */}
             <div class="details-wrapper">
                 <div class="overflow-hidden">
                     <div class="details-content pt-2">
                         <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">{item.description}</p>
                         
                         {item.links && item.links.length > 0 && (
                           <div class="flex flex-wrap gap-6 pt-4 border-t border-white/5">
                               {item.links.map(link => (
                                   <a 
                                       href={link.url} 
                                       target="_blank" 
                                       rel="noopener noreferrer" 
                                       class="text-xs uppercase tracking-widest text-slate-300 hover:text-white transition-colors flex items-center gap-1 group/link relative z-10 whitespace-nowrap"
                                   >
                                       {link.label}
                                       <ExternalLinkIcon class="w-3 h-3 opacity-50 group-hover/link:opacity-100 transition-opacity" />
                                   </a>
                               ))}
                           </div>
                         )}
                     </div>
                 </div>
             </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Key Results Section -->
  <section id="results" class="max-w-4xl mx-auto px-4 mb-24">
    <div class="mb-10 border-b border-white/5 pb-4">
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400">
        Key Results
      </h2>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/10 uppercase tracking-wider text-slate-500 text-xs font-light">
          <tr>
            <th class="px-2 py-3 font-normal">Year</th>
            <th class="px-4 py-3 font-normal">Sport</th>
            <th class="px-4 py-3 font-normal">Event</th>
            <th class="px-4 py-3 font-normal hidden md:table-cell">Location</th>
            <th class="px-4 py-3 font-normal">Distance</th>
            <th class="px-4 py-3 font-normal">Time</th>
            <th class="px-4 py-3 font-normal">Result</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-300 font-light">
          {results.map(row => (
            <tr class="transition-colors hover:bg-white/[0.02]">
              <td class="px-2 py-4 text-slate-500 font-mono text-xs align-top">{row.year}</td>
              <td class="px-4 py-4 text-slate-300 align-top">{row.sport}</td>
              <td class="px-4 py-4 text-slate-100 font-medium align-top">{row.event}</td>
              <td class="px-4 py-4 text-slate-500 hidden md:table-cell text-xs align-top">{row.location}</td>
              <td class="px-4 py-4 text-slate-400 whitespace-nowrap text-xs align-top">{row.distance}</td>
              <td class="px-4 py-4 font-mono text-slate-300 align-top">
                {row.link ? (
                  <a href={row.link} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors underline decoration-slate-700 underline-offset-4 flex items-center gap-1 w-fit group/link">
                    {row.time}
                    <ExternalLinkIcon class="w-3 h-3 opacity-50 group-hover/link:opacity-100 transition-opacity" />
                  </a>
                ) : (
                  row.time
                )}
              </td>
              <td class="px-4 py-4 text-slate-400 text-xs whitespace-pre-line align-top">
                <div class="flex items-start gap-2">
                  {row.highlight === 'gold' && <div class="w-1.5 h-1.5 rounded-full bg-yellow-500 mt-1 flex-shrink-0 shadow-[0_0_8px_rgba(234,179,8,0.5)]"></div>}
                  {row.highlight === 'silver' && <div class="w-1.5 h-1.5 rounded-full bg-slate-300 mt-1 flex-shrink-0 shadow-[0_0_8px_rgba(203,213,225,0.5)]"></div>}
                  {row.highlight === 'bronze' && <div class="w-1.5 h-1.5 rounded-full bg-orange-600 mt-1 flex-shrink-0 shadow-[0_0_8px_rgba(234,88,12,0.5)]"></div>}
                  {row.highlight === 'pb' && <div class="w-1.5 h-1.5 rounded-full bg-indigo-400 mt-1 flex-shrink-0 shadow-[0_0_8px_rgba(129,140,248,0.5)]"></div>}
                  {!row.highlight && <div class="w-1.5 h-1.5 mt-1 flex-shrink-0"></div>}
                  <span>{row.result}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  /* Smooth expansion animations */
  .summary-wrapper {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    opacity: 1;
  }
  .highlight-card[data-expanded="true"] .summary-wrapper {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .details-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    opacity: 0;
  }

  .highlight-card[data-expanded="true"] .details-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  
  /* Scrollbar hiding */
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  
  .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
  }

  /* Media track behavior */
  .media-track {
      pointer-events: none; /* Disable scrolling when collapsed */
  }
  
  .highlight-card[data-expanded="true"] .media-track {
      pointer-events: auto; /* Enable scrolling when expanded */
  }

  /* Nav Buttons */
  .highlight-card[data-expanded="true"] .nav-btn {
      opacity: 1;
      pointer-events: auto;
  }
</style>

<script>
  function initSportPage() {
    // Setup highlight cards interactivity
    const cards = document.querySelectorAll('.highlight-card');
    cards.forEach(card => {
        // Prevent double initialization
        if (card.hasAttribute('data-initialized')) return;
        card.setAttribute('data-initialized', 'true');

        // Nav Buttons Logic
        const prevBtn = card.querySelector('.nav-btn.prev');
        const nextBtn = card.querySelector('.nav-btn.next');
        const mediaTrack = card.querySelector('.media-track');

        if (prevBtn && nextBtn && mediaTrack) {
            const scrollAmount = () => card.clientWidth; // Scroll one width

            prevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                // Infinite Loop Logic: Left
                if (mediaTrack.scrollLeft <= 5) {
                    mediaTrack.scrollTo({ left: mediaTrack.scrollWidth, behavior: 'smooth' });
                } else {
                    mediaTrack.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
                }
            });

            nextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                // Infinite Loop Logic: Right
                const maxScroll = mediaTrack.scrollWidth - mediaTrack.clientWidth;
                if (mediaTrack.scrollLeft >= maxScroll - 5) {
                     mediaTrack.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    mediaTrack.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
                }
            });
        }

        card.addEventListener('click', (e) => {
            // Don't toggle if clicking a link/button inside OR interacting with video controls
            const target = e.target as HTMLElement;
            if (target.closest('a') || target.closest('button') || target.tagName === 'VIDEO' || target.closest('.media-track')) {
                // Allow interactions with media track only if already expanded
                 if (card.getAttribute('data-expanded') === 'true' && (target.tagName === 'VIDEO' || target.closest('.media-track'))) {
                     return;
                 }
                 if (target.closest('a') || target.closest('button')) return;
            }
            
            const isExpanded = card.getAttribute('data-expanded') === 'true';
            card.setAttribute('data-expanded', String(!isExpanded));
        });

        // Add keyboard support
        card.addEventListener('keydown', (e) => {
            if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
                (e as KeyboardEvent).preventDefault();
                card.click();
            }
        });
    });
  }

  // Apply on load
  initSportPage();

  // Re-apply after view transitions
  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname.includes('/sport')) {
      initSportPage();
    }
  });
</script>

