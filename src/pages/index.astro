---

<Layout title="Dimitri Unuchek | RnD Leader & Physicist" ogTitle="Dimitri Unuchek, PhD - R&D Leader & Physicist" ogDescription="Photonics, Optoelectronics, Quantum Devices">
  <!-- Mobile Profile Header -->
  <div class="sm:hidden relative -mx-2 -mt-20 mb-4 w-[calc(100%+1rem)] h-[55vh] min-h-[400px] overflow-hidden pointer-events-none">
    <!-- Background Image with dual opacity masks -->
    <div class="absolute inset-0" style="mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);">
      <img 
        src={profilePhoto.src} 
        alt="Dimitri Unuchek" 
        class="w-full h-[110%] max-w-none object-contain object-[center_40%] translate-x-[27%] -translate-y-[5%] -scale-x-100 opacity-80 dark:opacity-70 brightness-[0.8] dark:brightness-[0.6] contrast-[1.1]"
        style="mask-image: radial-gradient(ellipse 90% 90% at 60% 40%, black 50%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 90% 90% at 60% 40%, black 50%, transparent 80%);"
      />
    </div>
    <!-- Top Gradient Overlay purely for text readability -->
    <div class="absolute inset-x-0 top-0 h-[40%] bg-gradient-to-b from-slate-900/60 dark:from-black/60 to-transparent pointer-events-none"></div>
    
    <!-- Content (Title & Info) at the top -->
    <div class="absolute top-0 left-0 w-full pt-20 px-8 text-left z-10">
      <h2 class="text-[2.5rem] font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-600 mb-2 leading-tight tracking-tight drop-shadow-md">
        Dr Dimitri Unuchek
      </h2>
      <p class="text-xl text-slate-800 dark:text-slate-400 font-medium mb-3 drop-shadow">R&D Leader <span class="text-slate-500 dark:text-slate-600">|</span> Physicist</p>
      <p class="text-sm text-slate-700 dark:text-slate-400 flex items-center justify-start gap-1.5 opacity-90 drop-shadow">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Lausanne, Switzerland
      </p>
    </div>
  </div>

  <!-- Mobile Buttons (above hero) -->
  <div class="sm:hidden flex flex-wrap gap-3 justify-center mb-6 px-4">
    <a href="#projects" class="px-8 py-3 bg-slate-900 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-100 text-white dark:text-slate-900 rounded-full font-medium transition-colors duration-300">
      My Work
    </a>
    <a href={`${base}/CV_mar2026 - CH - photo.pdf`} download class="px-8 py-3 bg-transparent text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-white/20 hover:border-slate-900 dark:hover:border-slate-100 hover:text-slate-900 dark:hover:text-slate-100 rounded-full font-medium transition-all duration-300 flex items-center gap-2 group">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:text-slate-900 dark:group-hover:text-slate-100 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      My CV
    </a>
  </div>

  <!-- Hero Section -->
  <section id="hero" class="max-w-4xl mx-auto px-4 mb-24 md:mb-32 pt-4 md:pt-16">
    <div class="flex flex-row items-stretch gap-6 md:gap-12">
      
      <!-- Rotated Title (Visible on both) -->
      <div class="hidden sm:flex flex-shrink-0 items-center justify-center border-r border-slate-200 dark:border-white/10 pr-6 md:pr-8">
        <h1 class="text-4xl md:text-[2.75rem] leading-none font-bold tracking-tight text-slate-900 dark:text-slate-100 whitespace-nowrap" style="writing-mode: vertical-rl; transform: rotate(180deg);">
          Scalable Hardware
        </h1>
      </div>

      <!-- Bio Content -->
      <div class="text-justify flex-1 flex flex-col justify-center">
        <p class="text-lg text-slate-700 dark:text-slate-300 font-light leading-relaxed mb-6">
          I am an R&D leader and scientist with a PhD from EPFL, specializing in the development of next-generation optoelectronics and semiconductor products.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-400 font-light leading-relaxed mb-6">
          With 6 years in industrial R&D management and 7 years of academic research, my career spans from pioneering fundamental research of quantum phenomena in 2D materials to building and managing diverse cross-disciplinary teams and driving product development from POC to industrialization in the field of optics, electronics, renewable energy and quantum devices.
        </p>
