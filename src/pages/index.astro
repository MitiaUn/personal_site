<script>
  function setupTalksCarousel() {
    const carousel = document.getElementById('talks-carousel');
    if (!carousel) return;
    if (carousel.hasAttribute('data-carousel-initialized')) return;
    carousel.setAttribute('data-carousel-initialized', 'true');

    const viewport = carousel.querySelector('.carousel-viewport');
    const track = carousel.querySelector('.carousel-track');
    const thumbs = carousel.querySelectorAll('.carousel-thumb');
    const prevBtn = carousel.querySelector('.carousel-prev');
    const nextBtn = carousel.querySelector('.carousel-next');
    const scrollStep = 200;

    function updateArrows() {
      if (!viewport) return;
      const atStart = viewport.scrollLeft <= 5;
      const atEnd = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 5;
      if (prevBtn) prevBtn.style.opacity = atStart ? '0' : '1';
      if (prevBtn) prevBtn.style.pointerEvents = atStart ? 'none' : 'auto';
      if (nextBtn) nextBtn.style.opacity = atEnd ? '0' : '1';
      if (nextBtn) nextBtn.style.pointerEvents = atEnd ? 'none' : 'auto';
    }

    viewport?.addEventListener('scroll', updateArrows);
    updateArrows();

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      viewport?.scrollBy({ left: -scrollStep, behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      viewport?.scrollBy({ left: scrollStep, behavior: 'smooth' });
    });

    // Swipe support on viewport
    let startX = 0;
    viewport?.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    viewport?.addEventListener('touchend', (e) => {
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        viewport?.scrollBy({ left: diff > 0 ? scrollStep : -scrollStep, behavior: 'smooth' });
      }
    });

    // Lightbox
    const lightbox = document.getElementById('talks-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const srcs = Array.from(thumbs).map(t => t.querySelector('img')?.src || '');
    let currentLightbox = 0;

    function openLightbox(index) {
      currentLightbox = index;
      if (lightboxImg) lightboxImg.src = srcs[index];
      if (lightbox) {
        lightbox.style.display = 'flex';
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.style.display = 'none';
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function lightboxGoTo(index) {
      currentLightbox = ((index % srcs.length) + srcs.length) % srcs.length;
      if (lightboxImg) lightboxImg.src = srcs[currentLightbox];
    }

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const idx = parseInt(thumb.getAttribute('data-index') || '0');
        openLightbox(idx);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', (e) => { e.stopPropagation(); lightboxGoTo(currentLightbox - 1); });
    lightboxNext?.addEventListener('click', (e) => { e.stopPropagation(); lightboxGoTo(currentLightbox + 1); });

    // Close on backdrop click
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.style.display === 'none') return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxGoTo(currentLightbox - 1);
      if (e.key === 'ArrowRight') lightboxGoTo(currentLightbox + 1);
    });

    // Swipe support in lightbox
    let lbStartX = 0;
    lightbox?.addEventListener('touchstart', (e) => { lbStartX = e.touches[0].clientX; }, { passive: true });
    lightbox?.addEventListener('touchend', (e) => {
      const diff = lbStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) lightboxGoTo(currentLightbox + (diff > 0 ? 1 : -1));
    });
  }

  setupTalksCarousel();
  document.addEventListener('astro:page-load', setupTalksCarousel);
</script>
